---
import Cta from "./Cta.astro";
import MobileNavigation from "./MobileNavigation.astro";

interface Props {
	active?: "home" | "works" | "about";
}

const { active = "home" } = Astro.props;

const navItems = [
	{ key: "home", label: "Home", href: "/" },
	{ key: "works", label: "Works", href: "/works" },
	{ key: "about", label: "About", href: "/about" },
];
---

<header class="header">
	<div class="container header__inner">
		<nav class="nav" aria-label="Primary">
			{
				navItems.map((item) => (
					<a
						href={item.href}
						class:list={["nav__link", { "nav__link--active": (item.key === active) }]}
						aria-current={(item.key === active) ? "page" : undefined}
					>
						{item.label}
					</a>
				))
			}
		</nav>

		<Cta label="Contact Me" href="https://www.linkedin.com/in/maryamul-aasia/" target="_blank" variant="solid" icon="linkedin" class="header__cta" />
	</div>
	<MobileNavigation active={active} />
</header>

<script>
	const header = document.querySelector<HTMLElement>(".header");
	if (header) {
		let lastScrollY = window.scrollY;
		let movement = 0;
		let frameRequested = false;

		const updateHeader = () => {
			const scrollY = window.scrollY;
			const delta = scrollY - lastScrollY;
			if (Math.sign(delta) !== Math.sign(movement)) movement = delta;
			else movement += delta;
			header.classList.toggle("header--scrolled", scrollY > 8);
			if (scrollY <= 8 || header.querySelector(".mobile-navigation--open")) {
				header.classList.remove("header--hidden");
				movement = 0;
			} else if (movement > 8 && scrollY > header.offsetHeight) {
				header.classList.add("header--hidden");
				movement = 0;
			} else if (movement < -8) {
				header.classList.remove("header--hidden");
				movement = 0;
			}
			lastScrollY = scrollY;
			frameRequested = false;
		};

		window.addEventListener("scroll", () => {
			if (frameRequested) return;
			frameRequested = true;
			requestAnimationFrame(updateHeader);
		}, { passive: true });
		updateHeader();
	}
</script>

<style>
	.header {
		position: sticky;
		top: 0;
		z-index: 10;
		padding-top: 34px;
		padding-bottom: 28px;
		transition: transform 220ms ease;
	}

	.header--scrolled { background: var(--bg); box-shadow: 0 1px 0 var(--hairline-soft); }
	.header--hidden { transform: translateY(-100%); pointer-events: none; }
	.header:has(.mobile-navigation--open) { transform: none; pointer-events: auto; }

	.header__inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
	}

	.nav {
		display: flex;
		align-items: center;
		gap: 58px;
	}

	.nav__link {
		position: relative;
		font-size: 24px;
		font-weight: 500;
		color: var(--text-muted);
		letter-spacing: 0.005em;
		padding-bottom: 4px;
		transition: color 190ms ease;
	}

	/* Purple hover (same --violet token as the Contact Me button fill)
	   applies to every link EXCEPT the current active page — the :not()
	   guarantees this by selector logic rather than specificity/source
	   order, so it can't accidentally start matching the active link. */
	.nav__link:not(.nav__link--active):hover {
		color: var(--violet);
	}

	.nav__link--active {
		color: var(--accent);
	}

	/* Replaces the old native text-decoration underline with a pseudo-element
	   at the exact same position/size/colour (measured against a screenshot
	   of the previous text-decoration: underline; text-underline-offset: 7px;
	   text-decoration-thickness: 2px; rendering), so it can be scaleX
	   animated — text-decoration itself can't be transform-animated.
	   animation-fill-mode "both" (the trailing `both` below) holds the
	   scaleX(0) start state before the animation begins, so there's no
	   flash of a full-width line before it draws in, and holds scaleX(1)
	   after — the final position/size is identical to the line it replaces. */
	.nav__link--active::after {
		content: "";
		position: absolute;
		left: 0;
		right: 0;
		bottom: 3px;
		height: 2px;
		background: currentColor;
		transform-origin: left center;
		animation: navUnderlineIn 300ms cubic-bezier(0.16, 1, 0.3, 1) both;
	}

	@keyframes navUnderlineIn {
		from {
			transform: scaleX(0);
		}
		to {
			transform: scaleX(1);
		}
	}

	.header__inner :global(.cta) {
		margin-right: -14px;
	}

	.header__inner :global(.header__cta) {
		font-size: 22px;
		padding: 14px 22px;
		gap: 8px;
		--cta-cut: 18px;
	}

	@media (max-width: 700px) {
		.header { padding: max(24px, env(safe-area-inset-top)) 0 24px; }
		.header__inner { gap: 24px; }
		.nav { gap: clamp(20px, 4vw, 44px); }
		.nav__link { min-height: 44px; display: flex; align-items: center; font-size: 20px; }
		.header__inner :global(.header__cta) { margin-right: 0; font-size: 20px; }
	}
	@media (max-width: 600px) {
		.header__inner { flex-wrap: wrap; gap: 16px; }
		.nav { width: 100%; justify-content: space-between; gap: 16px; }
		.nav__link { font-size: 18px; }
		.header__inner :global(.header__cta) { font-size: 18px; padding: 14px 20px; margin-inline: auto; }
	}
	@media (max-width: 700px) {
		.header { padding: 0; z-index: 100; }
		.header__inner { display: none; }
	}
	@media (prefers-reduced-motion: reduce) {
		.header { transition: none; }
	}

</style>
