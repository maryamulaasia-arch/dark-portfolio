---
import Cta from "./Cta.astro";

interface Props {
	active: "home" | "works" | "about";
}

const { active } = Astro.props;
const resumeUrl = "https://drive.google.com/file/d/1gDNM0vOyOEbpX7ixfrYwlGtaknI6dAnU/view?usp=sharing";
const linkedinUrl = "https://www.linkedin.com/in/maryamul-aasia/";
const navItems = [
	{ key: "home", label: "Home", href: "/" },
	{ key: "works", label: "Works", href: "/works" },
	{ key: "about", label: "About", href: "/about" },
];

// Use the same source icons and destinations as the existing footer.
const iconModules = import.meta.glob("../../public/Icons/*.svg", {
	query: "?raw",
	import: "default",
	eager: true,
}) as Record<string, string>;
const socials = [
	{ label: "Behance", file: "behance.svg", href: "https://www.behance.net/maryamulaasia1" },
	{ label: "Instagram", file: "Instagram.svg", href: "https://www.instagram.com/aasia_design?stkn=MW5wc2lndzViaWtlMw==" },
	{ label: "Dribbble", file: "Dribble.svg", href: "https://dribbble.com/maryamul_aasia" },
	{ label: "LinkedIn", file: "linkedin.svg", href: "https://www.linkedin.com/in/maryamul-aasia/" },
].map((social) => ({ ...social, svg: iconModules[`../../public/Icons/${social.file}`] }));
---

<div class="mobile-navigation">
	<div class="mobile-navigation__bar">
		<button class="mobile-navigation__toggle" type="button" aria-label="Open navigation" aria-expanded="false" aria-controls="mobile-navigation-panel">
			<svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
				<path d="M5 8h14M5 12h14M5 16h14" stroke="currentColor" stroke-width="1.5" stroke-linecap="square" />
			</svg>
		</button>
		<Cta label="Contact Me" href={linkedinUrl} target="_blank" variant="solid" icon="linkedin" class="mobile-navigation__cta mobile-navigation__cta--top" />
	</div>

	<div id="mobile-navigation-panel" class="mobile-navigation__panel" role="dialog" aria-modal="true" aria-label="Mobile navigation" aria-hidden="true" inert>
		<div class="mobile-navigation__content">
			<div class="mobile-navigation__panel-head">
				<button class="mobile-navigation__close" type="button" aria-label="Close navigation">
					<svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
						<path d="M6.5 6.5l11 11m0-11-11 11" stroke="currentColor" stroke-width="1.5" stroke-linecap="square" />
					</svg>
				</button>
			</div>

			<div class="mobile-navigation__main">
				<nav class="mobile-navigation__links" aria-label="Mobile primary">
					{navItems.map((item) => (
						<a href={item.href} aria-current={item.key === active ? "page" : undefined}>{item.label}</a>
					))}
				</nav>
				<Cta label="View Resume" href={resumeUrl} target="_blank" variant="solid" class="mobile-navigation__cta mobile-navigation__resume--panel" />
			</div>

			<div class="mobile-navigation__bottom">
				<p class="mobile-navigation__role"><span class="mobile-navigation__dot" aria-hidden="true"></span>Product / UI UX Designer</p>
				<div class="mobile-navigation__socials">
					{socials.map((social) => (
						<a href={social.href} target="_blank" rel="noopener noreferrer" aria-label={social.label} set:html={social.svg} />
					))}
				</div>
			</div>
		</div>
	</div>
</div>

<script>
	const navigation = document.querySelector<HTMLElement>(".mobile-navigation");
	const toggle = navigation?.querySelector<HTMLButtonElement>(".mobile-navigation__toggle");
	const panel = navigation?.querySelector<HTMLElement>(".mobile-navigation__panel");
	const closeButton = navigation?.querySelector<HTMLButtonElement>(".mobile-navigation__close");
	const mobileQuery = window.matchMedia("(max-width: 700px)");
	let previousScroll = 0;
	let lastFocused: HTMLElement | null = null;

	function closeMenu(restoreFocus = true) {
		if (!navigation?.classList.contains("mobile-navigation--open") || !panel || !toggle) return;
		navigation.classList.remove("mobile-navigation--open");
		panel.inert = true;
		panel.setAttribute("aria-hidden", "true");
		toggle.setAttribute("aria-expanded", "false");
		document.documentElement.classList.remove("mobile-navigation-is-open");
		document.body.classList.remove("mobile-navigation-is-open");
		document.body.style.removeProperty("top");
		document.body.style.removeProperty("position");
		document.body.style.removeProperty("width");
		window.scrollTo(0, previousScroll);
		if (restoreFocus) (lastFocused?.isConnected ? lastFocused : toggle).focus({ preventScroll: true });
	}

	function openMenu() {
		if (!navigation || !panel || !toggle || !closeButton || !mobileQuery.matches) return;
		lastFocused = document.activeElement instanceof HTMLElement ? document.activeElement : toggle;
		previousScroll = window.scrollY;
		document.documentElement.classList.add("mobile-navigation-is-open");
		document.body.classList.add("mobile-navigation-is-open");
		document.body.style.top = `-${previousScroll}px`;
		document.body.style.position = "fixed";
		document.body.style.width = "100%";
		panel.inert = false;
		panel.setAttribute("aria-hidden", "false");
		toggle.setAttribute("aria-expanded", "true");
		navigation.classList.add("mobile-navigation--open");
		closeButton.focus();
	}

	toggle?.addEventListener("click", openMenu);
	closeButton?.addEventListener("click", () => closeMenu());
	panel?.querySelectorAll<HTMLAnchorElement>("a[href]").forEach((link) => {
		link.addEventListener("click", () => closeMenu(false));
	});
	document.addEventListener("keydown", (event) => {
		if (!navigation?.classList.contains("mobile-navigation--open") || !panel) return;
		if (event.key === "Escape") {
			event.preventDefault();
			closeMenu();
		} else if (event.key === "Tab") {
			const focusable = [...panel.querySelectorAll<HTMLElement>("button, a[href]")];
			const first = focusable[0];
			const last = focusable[focusable.length - 1];
			if (event.shiftKey && document.activeElement === first) {
				event.preventDefault();
				last.focus();
			} else if (!event.shiftKey && document.activeElement === last) {
				event.preventDefault();
				first.focus();
			}
		}
	});
	mobileQuery.addEventListener("change", () => {
		if (!mobileQuery.matches) closeMenu(false);
	});
</script>

<style>
	.mobile-navigation { display: none; }

	@media (max-width: 700px) {
		.mobile-navigation { display: block; }
		.mobile-navigation__bar {
			display: flex;
			align-items: center;
			justify-content: space-between;
			gap: 16px;
			padding: max(45px, env(safe-area-inset-top)) max(24px, env(safe-area-inset-right)) 14px max(24px, env(safe-area-inset-left));
		}
		.mobile-navigation__toggle, .mobile-navigation__close {
			width: 44px;
			height: 44px;
			padding: 0;
			border: 0;
			background: transparent;
			color: #fff;
			display: grid;
			place-items: center;
			cursor: pointer;
		}
		.mobile-navigation__toggle svg, .mobile-navigation__close svg { width: 21px; height: 21px; }
		.mobile-navigation :global(.mobile-navigation__cta) {
			min-height: 40px;
			padding: 11px 13px;
			gap: 7px;
			font-size: 14px;
		}
		.mobile-navigation :global(.mobile-navigation__cta .cta__arrow) { width: 12px; height: 12px; }
		.mobile-navigation__panel {
			position: fixed;
			inset: 0;
			z-index: 101;
			width: 100%;
			height: 100vh;
			height: 100dvh;
			overflow-x: hidden;
			overflow-y: auto;
			overscroll-behavior: contain;
			background: repeating-linear-gradient(90deg, transparent 0 82px, rgba(202, 220, 228, .06) 82px 83px), var(--bg);
			color: #fff;
			visibility: hidden;
			opacity: 0;
			pointer-events: none;
			transition: opacity 240ms ease, visibility 0s linear 240ms;
		}
		.mobile-navigation__panel::before {
			content: "";
			position: absolute;
			inset: 0;
			pointer-events: none;
			background: radial-gradient(ellipse 55% 4% at 54% 23%, rgba(116, 74, 243, .5), transparent 78%), radial-gradient(ellipse 39% 5% at 55% 69%, rgba(116, 74, 243, .64), transparent 80%), radial-gradient(ellipse 18% 9% at 50% 52%, rgba(177, 143, 197, .2), transparent 80%);
			filter: blur(16px);
		}
		.mobile-navigation--open .mobile-navigation__panel {
			visibility: visible;
			opacity: 1;
			pointer-events: auto;
			transition-delay: 0s;
		}
		.mobile-navigation__content {
			position: relative;
			z-index: 1;
			min-height: 100%;
			width: min(100%, 480px);
			margin-inline: auto;
			padding: max(45px, env(safe-area-inset-top)) max(24px, env(safe-area-inset-right)) max(62px, env(safe-area-inset-bottom)) max(24px, env(safe-area-inset-left));
			display: flex;
			flex-direction: column;
			align-items: center;
		}
		.mobile-navigation__panel-head { width: 100%; display: flex; justify-content: flex-end; }
		.mobile-navigation__main {
			width: 100%;
			display: flex;
			flex-direction: column;
			align-items: center;
			padding-top: clamp(38px, 7vh, 94px);
		}
		.mobile-navigation__links { display: flex; flex-direction: column; align-items: center; gap: 22px; }
		.mobile-navigation__links a { color: var(--text-muted); font-size: 18px; font-weight: 400; line-height: 1.2; text-decoration: none; }
		.mobile-navigation__links a:hover, .mobile-navigation__links a:focus-visible { color: #fff; }
		.mobile-navigation__main :global(.mobile-navigation__resume--panel) { margin-top: 23px; }
		.mobile-navigation__bottom { margin-top: auto; padding-top: 64px; display: flex; flex-direction: column; align-items: center; gap: 19px; }
		.mobile-navigation__role { display: flex; align-items: center; gap: 10px; margin: 0; white-space: nowrap; color: #fff; font-size: clamp(17px, 5.4vw, 22px); }
		.mobile-navigation__dot { width: 13px; height: 13px; flex: none; border-radius: 50%; background: var(--violet); }
		.mobile-navigation__socials { display: flex; align-items: center; justify-content: center; gap: 9px; }
		.mobile-navigation__socials a { width: 44px; height: 44px; display: grid; place-items: center; color: #fff; }
		.mobile-navigation__socials a :global(svg) { width: 31px; height: 31px; display: block; }
		.mobile-navigation button:focus-visible, .mobile-navigation a:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
	}
	@media (prefers-reduced-motion: reduce) {
		.mobile-navigation__panel { transition: none; }
	}
</style>

<style is:global>
	@media (max-width: 700px) {
		html.mobile-navigation-is-open, body.mobile-navigation-is-open { overflow: hidden; }
	}
</style>
