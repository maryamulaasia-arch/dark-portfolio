---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import NotchBox from "../../components/NotchBox.astro";
import PixelText from "../../components/PixelText.astro";
import LetsTalk from "../../components/LetsTalk.astro";
import SiteFooter from "../../components/SiteFooter.astro";

/* ============================================================
   Content — every string below is read from
   references/BCL Case study.png (cross-checked only for wording
   against content/bcl content .docx). Confirmed corrections applied
   per the brief: "STATEMNT" -> "STATEMENT", "Domine" -> "Domain",
   "Cooperate" -> "Corporate", "AFTRE" -> "AFTER", "BEATS ARE VAGUE"
   -> "BEATS VAGUE", "50+ LED" -> "50+". The "RESULTS" heading is
   kept exactly as the PNG shows it (not "Impact", per the doc).
   Doc-only content (Timeline, Evaluators stat, the 5-word loop
   description, "The bet:" lead-in) is intentionally NOT included.

   GRID: reuses the established system — ONE container for the
   whole page, 626px body copy, 412px side copy (left-aligned even
   when the block sits on the right). Wide exceptions: the
   competitive-analysis, identity-trail IA, Redesign and Identity
   Trail images, which the reference shows bleeding past the
   nav-aligned container (all four are supplied compositions).

   CARD GEOMETRY: unlike FIC's uniform-gap cardgrid, BCL's 2x2 and
   3x2 NotchBox grids TOUCH vertically and only gap horizontally
   (verified directly against the reference at high zoom) — a
   different geometry, not forced to match FIC's pattern.
   ============================================================ */

const metaRow = [
	{ label: "Product", value: "Better Corporate Life" }, // corrected: PNG shows "Better Cooperate Life"
	{ label: "Domain", value: "B2B HR Tech" }, // corrected: PNG shows "Domine"
	{ label: "Platform", value: "Web App" },
	{ label: "Role", value: "UX Designer" },
];

const goalsCards = [
	{ title: "EARN TRUST BEFORE ASKING FOR ANYTHING", desc: "Build enough trust for users to openly share career doubts." },
	{ title: "GIVE THE AI SOMETHING TO WORK WITH", desc: "Capture identity, strengths, values, and goals for personal guidance." },
	{ title: "MAKE SELF-REFLECTION FEEL SIMPLE", desc: "Break career identity into simple, guided steps." },
	{ title: "TURN ONE SESSION INTO A RELATIONSHIP.", desc: "Build continuity, so every conversation moves forward." },
];

const roleCards = [
	{ title: "UX AUDIT & USABILITY TESTING", desc: "heuristic evaluation and moderated sessions on the existing chatbot" },
	{ title: "IDENTITY TRAIL {0→1}", desc: "defined and structured a new core experience" },
	{ title: "RAPID PROTOTYPING", desc: "lo-fi wireframes to pressure-test the interaction model" },
	{ title: "CONVERSATIONAL DESIGN", desc: "structured how the AI asks, reflects, and gives back" },
];

const auditCards = [
	{ title: "Inconsistent UI patterns", desc: "Users relearned the interface on every screen" },
	{ title: "Low-visibility CTAs", desc: "The next step was hard to find" },
	{ title: "No back actions", desc: "Flows users couldn't exit" },
	{ title: "Missing feedback", desc: "No confirmation that anything had happened" },
	{ title: "Unclear labels", desc: "High cognitive load" },
	{ title: "Chat friction", desc: "Inconsistent controls, no shortcuts" },
];

const failureRows = [
	{ label: "Trust", value: "No credibility signals, and no reason to open up" },
	{ label: "Value", value: "Nobody could say what the product did or where to start" },
	{ label: "Onboarding", value: "Multiple equal-weight entry points; users wanted one guided first step" },
	{ label: "Conversation", value: "Slow responses broke flow; the AI asked, but rarely gave back" },
	{ label: "Personalisation", value: "Advice that told users what they already knew" },
];

const coachingRows = [
	{ title: "PEOPLE OPEN UP BEFORE TAKING ADVICE", desc: "Human coaches listen first. Most AI tools jump straight to answers, making advice easier to dismiss." },
	{ title: "A CONVERSATION NEEDS STRUCTURE", desc: "Frameworks like GROW give coaching a beginning, middle, and end. Without one, users face an empty text box without knowing what to do." },
	{ title: "SELF-ASSESSMENTS STOP TOO EARLY", desc: "Quizzes reveal insights but often end there. The real value comes from knowing what to do next." },
	{ title: "SMALL AND SPECIFIC BEATS VAGUE", desc: "“Rethink your career” goes nowhere. “Message someone in your target role this week” is actionable." }, // corrected: PNG shows "BEATS ARE VAGUE"
	{ title: "PROGRESS NEEDS MEMORY", desc: "If every session starts fresh, users repeat themselves. Carrying past conversations forward makes guidance more meaningful." },
];

const dimensionRows = [
	{ label: "Context", value: "Grounds advice in what's actually possible" },
	{ label: "Strengths", value: "Builds on assets, not just gaps" },
	{ label: "Values & anchors", value: "Separates good advice from right-for-them advice" },
	{ label: "Aspirations", value: "Gives the conversation a destination" },
	{ label: "Tensions", value: "Explains why known advice isn't acted on" },
	{ label: "Coaching preference", value: "Shapes how the AI talks" },
];

const synthesisRows = [
	{ title: "01. TRUST IS STRUCTURAL, NOT VISUAL", note: "(from the audit)", desc: "The top heuristic violations were unpredictable patterns, no system feedback, no way back. Users won't disclose to a product that" },
	{ title: "02. GENERIC CONTEXT PRODUCES GENERIC ADVICE", note: "(from usability testing)", desc: "Surface-level context created surface-level guidance. The Trail captures six identity dimensions to make every conversation more personal." },
	{ title: "03. OPEN-ENDED REFLECTION OVERWHELMS", note: "(from coaching and identity research)", desc: "A blank chat expects users to know what to ask. The Trail replaces this with small, guided steps that deepen over time." },
];

const auditFoundRows = [
	{ label: "Inconsistent controls between messages and pop-ups", value: "One pattern set across the session — learned once, not relearned" },
	{ label: "The next step was hard to find", value: "A single, unmissable action at every point in the conversation" },
	{ label: "No way back out of a flow", value: "Every step in a session is exitable and revisitable" },
	{ label: "No confirmation anything had happened", value: "Visible system status — the AI shows it's thinking, and every action confirms" },
	{ label: "Labels users had to decode", value: "Plain language; nothing that needs interpreting mid-conversation" },
	{ label: "A blank box with no shortcuts", value: "Suggested prompts and consistent controls, so users never face an empty prompt" },
];

const beforeAfterRows = [
	{ label: "First impression", before: "“Creepy,” “like a student project”", after: "A guided first step with a clear promise" },
	{ label: "Entry point", before: "Multiple equal-weight options; nobody knew where to start", after: "One path in — the Trail" },
	{ label: "What the AI knows", before: "Surface-level, unstructured", after: "Six identity dimensions, built session by session" },
	{ label: "Advice", before: "What users already knew", after: "Grounded in their context, strengths, and constraints" },
	{ label: "Session 2", before: "Starts from zero", after: "Opens from the last conversation" },
];

const producedRows = [
	{ title: "A PRIORITIZED ROADMAP THE TEAM DIDN'T HAVE", desc: "50+ documented issues across 12 screens, ranked by severity, turning “the chatbot feels off” into a fixable backlog." },
	{ title: "A WORKING DEFINITION OF CAREER IDENTITY", desc: "Six dimensions that now shape what the AI asks, stores, and advises on. Personalization stopped being a copy problem and became a data model." },
	{ title: "A RETENTION MECHANIC, NOT JUST A FEATURE", desc: "Because guidance compounds, each session leads naturally to the next. That's the difference between a tool users try and a coach they keep." },
];
---

<Layout title="BCL — Maryamul Aasia">
	<Header active="works" />

	<main class="bcl">
		<!-- ============ HERO ============ -->
		<section class="hero">
			<div class="hero__device reveal">
				<img src="/images/BCL/hero.png" alt="StocAI coaching app shown on a desktop computer" />
			</div>
			<div class="hero__copy reveal" style="--reveal-delay:120ms">
				<h1 class="hero__title">BCL</h1>
				<p class="hero__subtitle">AI-powered career coaching for professionals.</p>
				<p class="hero__tags">UX Design<br />B2B SaaS</p>
			</div>
		</section>

		<!-- ============ META ROW ============ -->
		<section class="block meta reveal">
			<div class="meta__row">
				{
					metaRow.map((m, i) => (
						<>
							{i > 0 && <span class="meta__divider" aria-hidden="true" />}
							<div class="meta__col">
								<p class="meta__label">{m.label}</p>
								<p class="meta__value">{m.value}</p>
							</div>
						</>
					))
				}
			</div>
		</section>

		<!-- ============ ABOUT ============ -->
		<section class="block reveal">
			<div class="zgrid zgrid--mid">
				<div class="zgrid__left">
					<h2 class="h2">
						<PixelText text="ABOUT" pixel={[2]} /><br /><PixelText text="BCL" pixel={[0]} />
					</h2>
				</div>
				<div class="zgrid__right">
					<p class="sidewhite">Designing an AI Career Coach for Meaningful Career Growth</p>
				</div>
			</div>
			<div class="zgrid zgrid--mid zgrid--tight">
				<div class="zgrid__left">
					<p class="bodycol">
						Better Corporate Life (BCL) is an AI-powered career coaching platform that helps
						professionals understand their current career identity, define where they want to go, and
						navigate the gap between the two through personalized guidance.
					</p>
					<p class="bodycol">
						Your career is more than your current job title. StocAI helps you identify where you are
						to where you want to be.
					</p>
				</div>
				<div class="zgrid__right">
					<div class="about__art">
						<img src="/images/BCL/about.png" alt="Chess piece and ladders on stacked white blocks, representing career progression" />
					</div>
				</div>
			</div>
		</section>

		<!-- ============ PROBLEM STATEMENT ============ -->
		<section class="block reveal">
			<div class="zgrid">
				<div class="zgrid__left">
					<h2 class="h2 pixelify">PROBLEM<br />STATEMENT</h2>
				</div>
				<div class="zgrid__right">
					<blockquote class="sidewhite sidewhite--quote">
						&ldquo;I know I want something to change. I just can&rsquo;t say what, or where to
						start.&rdquo;<br />
						<span>- User Insight</span>
					</blockquote>
				</div>
			</div>
			<div class="zgrid zgrid--mid zgrid--tight zgrid--reverse">
				<div class="zgrid__left">
					<div class="problem__img">
						<img src="/images/BCL/Problem Statement.png" alt="Line-art illustration of a coach presenting to a small group" />
					</div>
				</div>
				<div class="zgrid__right zgrid__right--wide">
					<p class="bodycol">
						Users wanted a coach that understood who they were before offering advice, but a blank
						chat and generic responses made it difficult to build trust.
					</p>
					<p class="bodycol bodycol--strong">
						The challenge was circular: personalization required context, but sharing context
						required trust. Solving disclosure became the key to making the AI genuinely useful.
					</p>
				</div>
			</div>
		</section>

		<!-- ============ GOALS ============ -->
		<section class="block reveal">
			<div class="headrow">
				<h2 class="h2"><PixelText text="GOALS" pixel={[0, 2]} /></h2>
				<p class="headrow__side">What I set out to achieve with the redesign:</p>
			</div>
			<div class="cardgrid cardgrid--touch">
				{
					goalsCards.map((c) => (
						<NotchBox width={468} height={150} class="cardgrid__item">
							<div class="notchcard">
								<h3 class="notchcard__title">{c.title}</h3>
								<p class="notchcard__desc">{c.desc}</p>
							</div>
						</NotchBox>
					))
				}
			</div>
		</section>

		<!-- ============ MY ROLE ============ -->
		<section class="block reveal">
			<div class="headrow">
				<h2 class="h2 pixelify">MY ROLE</h2>
				<p class="headrow__side">Research-led thinking &middot; Systems thinking &middot; AI UX &middot; Cross-functional collaboration</p>
			</div>
			<p class="bodycol">I owned research and the end-to-end experience, working across product and engineering.</p>
			<div class="cardgrid cardgrid--touch">
				{
					roleCards.map((c) => (
						<NotchBox width={468} height={150} class="cardgrid__item">
							<div class="notchcard">
								<h3 class="notchcard__title">{c.title}</h3>
								<p class="notchcard__desc">{c.desc}</p>
							</div>
						</NotchBox>
					))
				}
			</div>
		</section>

		<!-- ============ RESEARCH ============ -->
		<!-- This section is unusually long (Research intro + 4 subsections),
		     so a single .reveal on the outer <section> would need 15% of
		     that whole height visible at once to trigger — never true in a
		     normal viewport, leaving it permanently invisible. Each
		     subsection gets its own .reveal wrapper instead, sized so the
		     15% threshold is reachable. -->
		<section class="block">
			<div class="reveal zgrid zgrid--mid">
				<div class="zgrid__left">
					<h2 class="h2"><PixelText text="RESEARCH" pixel={[3]} /></h2>
				</div>
				<div class="zgrid__right">
					<p class="sidewhite">
						Conducted a UX audit and usability testing to uncover friction, validate findings, and
						identify improvement opportunities.
					</p>
				</div>
			</div>
			<div class="reveal zgrid zgrid--mid zgrid--tight">
				<div class="zgrid__left">
					<p class="bodycol">
						Two weeks of heuristic audit, five moderated usability sessions on the live product,
						competitive benchmarking, and desk research into career coaching and identity frameworks.
					</p>
				</div>
				<div class="zgrid__right">
					<div class="photo__art">
						<img src="/images/BCL/Research.png" alt="Hands arranging colored sticky notes on a printed journey map" />
					</div>
				</div>
			</div>

			<!-- ---- 1. UX Audit ---- -->
			<div class="reveal">
			<h3 class="subhead pixelify">UX AUDIT</h3>
			<p class="bodycol">Heuristic evaluation of the existing product against Nielsen&rsquo;s 10 heuristics.</p>

			<div class="connectorrow">
				<div class="connectorrow__seg connectorrow__seg--cap">
					<svg class="connectorrow__shape" viewBox="0 0 100 54" preserveAspectRatio="none" aria-hidden="true">
						<path d="M0,1 H78 C90,1 94,14 99,27 C94,40 90,53 78,53 H0" stroke="#8a8a8a" stroke-width="1.2" fill="none" vector-effect="non-scaling-stroke" />
					</svg>
					<span class="connectorrow__label">DURATION :</span> <span class="connectorrow__value">2 WEEK</span>
				</div>
				<div class="connectorrow__seg connectorrow__seg--mid">
					<span class="connectorrow__label">SCREENS :</span> <span class="connectorrow__value">12</span>
				</div>
				<div class="connectorrow__seg connectorrow__seg--cap connectorrow__seg--capRight">
					<svg class="connectorrow__shape" viewBox="0 0 100 54" preserveAspectRatio="none" aria-hidden="true">
						<path d="M100,1 H22 C10,1 6,14 1,27 C6,40 10,53 22,53 H100" stroke="#8a8a8a" stroke-width="1.2" fill="none" vector-effect="non-scaling-stroke" />
					</svg>
					<span class="connectorrow__label">FINDINGS :</span> <span class="connectorrow__value">50+</span>
				</div>
			</div>

			<div class="zgrid zgrid--mid">
				<div class="zgrid__left">
					<div class="photo__art photo__art--sm">
						<img src="/images/BCL/Audit.png" alt="Annotated screenshot of the existing coach-selection modal with numbered audit callouts" />
					</div>
				</div>
				<div class="zgrid__right zgrid__right--wide">
					<p class="bodycol">
						<strong>Screens audited:</strong> navigation, home, onboarding, chat, in-session pop-ups
						(feedback, focus, insight, action, conclusion), summary &amp; completion, log in.
					</p>
					<p class="bodycol">
						<strong>Top violations:</strong> Consistency &amp; Standards &middot; Visibility of System
						Status &middot; User Control &amp; Freedom &middot; Recognition Rather Than Recall
					</p>
				</div>
			</div>

			<div class="cardgrid cardgrid--touch cardgrid--three">
				{
					auditCards.map((c) => (
						<NotchBox width={306} height={168} class="cardgrid__item">
							<div class="notchcard notchcard--left">
								<h3 class="notchcard__title notchcard__title--white notchcard__title--plain">{c.title}</h3>
								<p class="notchcard__desc">{c.desc}</p>
							</div>
						</NotchBox>
					))
				}
			</div>

			<p class="bodycol bodycol--wide">
				<strong>Why it mattered:</strong> every top violation was a trust failure, not a visual one. A
				product that asks users to name their career doubts cannot behave unpredictably. Trust first,
				then personalisation.
			</p>
			<a class="readmore" href="https://drive.google.com/file/d/1ti7_ONDqPIXQ5vYxgT4xP-opX1R5ILLG/view?usp=sharing" target="_blank" rel="noopener noreferrer">Read Full report</a>
			</div>

			<!-- ---- 2. Usability Testing ---- -->
			<div class="reveal">
			<h3 class="subhead pixelify subhead--wide">Usability Testing For Existing Flow, 5 Participants</h3>
			<div class="zgrid zgrid--mid">
				<div class="zgrid__left">
					<p class="bodycol">
						I ran moderated sessions on the existing live flow, taking participants through
						onboarding and a full coaching conversation as it shipped.
					</p>
					<p class="bodycol">
						<strong>Objective:</strong> find what breaks trust, engagement, and task completion in the
						current experience.
					</p>
				</div>
				<div class="zgrid__right">
					<div class="photo__art">
						<img src="/images/BCL/Usability testing.png" alt="Moderated usability testing session with a video-call panel over the coaching app" />
					</div>
				</div>
			</div>

			<div class="table-wrap">
				<table class="ctable2">
					<thead>
						<tr>
							<th><span class="tagchip pixelify">FAILURE</span></th>
							<th><span class="tagchip pixelify">WHAT HAPPENED</span></th>
						</tr>
					</thead>
					<tbody>
						{
							failureRows.map((r) => (
								<tr>
									<td class="ctable2__label">{r.label}</td>
									<td>{r.value}</td>
								</tr>
							))
						}
					</tbody>
				</table>
			</div>

			<p class="bodycol bodycol--wide">
				The verdict was blunt. Users called it &ldquo;creepy,&rdquo; &ldquo;unprofessional,&rdquo;
				&ldquo;like a student project.&rdquo; Most said they wouldn&rsquo;t share personal career
				information with it.
			</p>
			<a class="readmore" href="https://drive.google.com/file/d/1fbObFNydFdv-vbIsImg9WZuKs9WnPxSi/view?usp=sharing" target="_blank" rel="noopener noreferrer">Read Full report</a>
</div>

			<!-- ---- 3. Career Coaching & Identity Research ---- -->
			<div class="reveal">
			<h3 class="subhead pixelify subhead--wide">Career Coaching &amp; Identity Research</h3>
			<div class="zgrid zgrid--mid">
				<div class="zgrid__left">
					<p class="bodycol">
						Desk research across two connected questions: how good coaching works, and what a career
						identity is actually made of — drawing on coaching platforms, reflection apps, AI career
						tools, and the literature on professional identity <em>(Schein&rsquo;s Career Anchors,
						Ibarra, Savickas, Self-Determination Theory).</em>
					</p>
				</div>
				<div class="zgrid__right">
					<div class="photo__art">
						<img src="/images/BCL/Coach.png" alt="Two people in conversation during a coaching session" />
					</div>
				</div>
			</div>
			</div>

			<div class="reveal">
			<h4 class="subhead2 pixelify">How coaching works</h4>
			<div class="goalstack">
				{
					coachingRows.map((r) => (
						<NotchBox width={968} height={126} class="goalstack__item">
							<div class="goalrow">
								<h3 class="goalrow__title">{r.title}</h3>
								<p class="goalrow__desc">{r.desc}</p>
							</div>
						</NotchBox>
					))
				}
			</div>
			</div>

			<div class="reveal">
			<h4 class="subhead2 pixelify">What identity is made of</h4>
			<p class="bodycol bodycol--wide">
				<strong>Core finding: identity isn&rsquo;t one data point, and it isn&rsquo;t stable.</strong>{" "}
				That rules out a one-time quiz and points to something the product builds over time.
			</p>

			<div class="table-wrap">
				<table class="ctable2">
					<thead>
						<tr>
							<th><span class="tagchip pixelify">DIMENSION</span></th>
							<th><span class="tagchip pixelify">WHY THE AI NEEDS IT</span></th>
						</tr>
					</thead>
					<tbody>
						{
							dimensionRows.map((r) => (
								<tr>
									<td class="ctable2__label">{r.label}</td>
									<td>{r.value}</td>
								</tr>
							))
						}
					</tbody>
				</table>
			</div>
			</div>

			<!-- ---- 4. Competitive Analysis ---- -->
			<div class="reveal">
			<h3 class="subhead pixelify">Competitive Analysis</h3>
			<p class="bodycol bodycol--wide">Four AI-led guidance products, benchmarked on memory, structure, and personalisation.</p>
			</div>
		</section>
		<div class="wide-break reveal">
			<img src="/images/BCL/competitive-analysis.png" alt="Competitive analysis table comparing Ash, Dehurdle, Summit and Headspace" />
		</div>
		<section class="block reveal">
			<p class="bodycol bodycol--wide" style="margin-top:40px">
				The gap: each of these knows something about the user: mood, goals, streaks. None builds a
				professional identity picture: strengths, values, aspirations, blockers. Without that, guidance is
				either emotionally supportive or task-focused, never career-specific.
			</p>
		</section>

		<!-- ============ SYNTHESIS ============ -->
		<section class="block reveal">
			<div class="headrow">
				<h2 class="h2"><PixelText text="SYNTHESIS" pixel={[1, 6]} /></h2>
				<p class="headrow__side">
					&ldquo;Users don&rsquo;t just want an AI that answers career questions. They want an AI that
					understands who they are first.&rdquo;
				</p>
			</div>
			<p class="bodycol bodycol--wide">
				The three become one mechanic: a progressive disclosure loop where structure earns trust, trust
				unlocks context, and context makes the next conversation better than the last.
			</p>
			<div class="goalstack">
				{
					synthesisRows.map((r) => (
						<NotchBox width={968} height={126} class="goalstack__item">
							<div class="goalrow">
								<h3 class="goalrow__title">
									{r.title} <em class="goalrow__note">{r.note}</em>
								</h3>
								<p class="goalrow__desc">{r.desc}</p>
							</div>
						</NotchBox>
					))
				}
			</div>
		</section>

		<!-- ============ INFORMATION ARCHITECTURE ============ -->
		<section class="block reveal">
			<h2 class="h2">
				<PixelText text="INFORMATION" pixel={[6, 10]} /><br /><PixelText text="ARCHITECTURE" pixel={[3, 6]} />
			</h2>
		</section>
		<div class="wide-break wide-break--ia reveal">
			<img src="/images/BCL/identity-trail-ia.png" alt="Identity Trail information architecture tree" />
		</div>

		<!-- ============ THE SOLUTION ============ -->
		<section class="block reveal">
			<div class="headrow">
				<h2 class="h2">THE <PixelText text="SOLUTION" pixel={[1]} /></h2>
				<p class="headrow__side">
					The problem had two halves, so the solution did too, in the order the research demanded: fix
					trust, then personalise.
				</p>
			</div>

			<h3 class="subhead pixelify">Part 1 Redesigning the Chat</h3>
			<p class="bodycol bodycol--wide">
				Identity Trail asks users to disclose. Nobody discloses to a product that behaves unpredictably.
				So the audit findings had to be resolved first, not as polish, but as the precondition for
				everything else.
			</p>
			<p class="bodycol bodycol--wide">
				The audit covered 12 screens, but I prioritized <strong>chat</strong>: it&rsquo;s where disclosure
				happens, where the coaching actually takes place, and where testing showed trust collapsing
				fastest. Fixing it moved the most, soonest. The remaining findings were documented as a
				prioritized backlog for the team.
