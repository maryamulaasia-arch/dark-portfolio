	/* ============================================================
	   Hero — fits the same nav/meta-row bounding box as the rest of
	   the page (var(--container)). The device composition is rendered
	   at its full, unscaled 1599:764 asset ratio; only its width is
	   set, so nothing is stretched or cropped.
	   ============================================================ */
	.hero {
		position: relative;
		max-width: var(--container);
		margin-inline: auto;
		padding: 30px 24px 0;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 24px;
		min-height: 360px;
	}

	.hero__device {
		position: relative;
		width: 561px;
		flex-shrink: 0;
	}

	.hero__device img {
		width: 100%;
		height: auto;
		display: block;
		/* oni-hero.png bakes in a leftover "UX/Product design / Healthcare
		   UX" caption past the laptop's right edge (we render that copy
		   ourselves, live, in .hero__tags, positioned at that same spot) —
		   fully fade out that trailing sliver, well clear of every device,
		   so the baked copy doesn't show through under the live text. */
		-webkit-mask-image: linear-gradient(to right, #000 0%, #000 60%, transparent 68%);
		mask-image: linear-gradient(to right, #000 0%, #000 60%, transparent 68%);
	}

	/* Positioned at the exact spot the baked-in caption occupies in the
	   source asset (measured directly on oni-hero.png: the text starts at
	   75.2% of the image's width, 84.4% of its height) — i.e. immediately
	   right of the laptop's lower half, not stacked under the whole
	   composition. Left-aligned, and free to overflow past the device
	   column's own edge since the caption is wider than the masked sliver
	   it replaces. */
	.hero__tags {
		position: absolute;
		left: 75.2%;
		top: 84.4%;
		text-align: left;
		white-space: nowrap;
		font-size: 19px;
		line-height: 1.4;
		color: #99999999;
	}

	.hero__copy {
		flex: 1;
		min-width: 240px;
		text-align: right;
	}

	.hero__title {
		font-size: 76px;
		font-weight: 500;
		text-transform: uppercase;
		letter-spacing: 0.01em;
		line-height: 1;
