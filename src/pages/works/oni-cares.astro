---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import NotchBox from "../../components/NotchBox.astro";
import PixelText from "../../components/PixelText.astro";
import LetsTalk from "../../components/LetsTalk.astro";
import SiteFooter from "../../components/SiteFooter.astro";

/* ============================================================
   Content — every string below is read directly from
   references/ONI Case study.png. Typos present in that PNG are
   reproduced verbatim EXCEPT the corrections explicitly confirmed
   by the user (see each spot below), per the brief's
   "PNG contains it -> include it" rule.

   GRID: the whole page uses ONE container width — the same
   Home-nav-to-Contact-Me bounding box as the header
   (var(--container): 1016px + 24px inline padding). Verified by
   pixel-measuring the reference: the header's visible content spans
   x≈237..1230 at 1440px width, and every other row checked (meta
   row, card grids, the competitive table, the journey/IA diagrams)
   lines up with that same box within a few px of bleed — there is
   no separate "wide" container anywhere on this page. Only the hero
   device composition intentionally bleeds further left (see .hero).
   ============================================================ */

const metaRow = [
	{ label: "Product", value: "ONI DIDI" },
	{ label: "Domain", value: "Maternal Health" }, // corrected: PNG shows "Domine"
	{ label: "Platform", value: "Responsive Design" },
	{ label: "Role", value: "Product Designer" },
];

const problemCards = [
	{ title: "MISSED INPUTS", desc: "Important information could be skipped or documented later." },
	{ title: "DIVIDED ATTENTION", desc: "Typing competed with the patient conversation." },
	{ title: "INCONSISTENT RECORDS", desc: "Documentation varied across doctors and visits." },
	{ title: "NO SAFETY NET", desc: "The system couldn't surface potentially missing information." },
];

const roleCards = [
	{ title: "0→1 PRODUCT DESIGN", desc: "Led the end-to-end design of the doctor-facing mobile app" },
	{ title: "AI UX", desc: "Designed AI Prompts, follow-ups, summaries, and information retrieval" },
	{ title: "RESPONSIVE DESIGN", desc: "Designed across web , tablet, and mobile." },
	{ title: "AI TESTING", desc: "Consultation scenarios and edge cases" },
];

const researchStatus = [
	{ label: "STATUS", value: "TIME-PRESSED" },
	{ label: "PRIORITY", value: "PATIENT CONVERSATION" },
	{ label: "CONTROL", value: "DOCTOR LED" },
];

const researchThemes = [
	{ title: "Notes came second", desc: "Patients came first" },
	{ title: "Flexibility matters", desc: "Work happens anywhere" },
	{ title: "Data entry slows", desc: "Long forms add friction" },
	{ title: "AI should assist", desc: "Doctors stay in control" },
];

/* "Context" — the PNG's rendered pixel glyphs literally spell "CONTACT" (verified
   by zooming the source image), but this matches the user's explicit correction
   the same way "Domain"/"Risk factor in appointment" do elsewhere in the brief. */
const competitiveHeaders = ["PRODUCT", "WORKFLOW", "DOCS", "AI", "SPECIALTY", "CONTEXT", "DEVICES"];
const competitiveRows = [
	["HealthPlix", "Strong", "Strong", "Strong", "Strong", "Moderate", "Moderate"],
	["Eka Care", "Moderate", "Moderate", "Moderate", "Moderate", "Strong", "Strong"],
	["Augnito", "Moderate", "Strong", "Strong", "Broad", "Limited", "Strong"],
	["Practo Ray", "Strong", "Moderate", "Limited", "Limited", "Moderate", "Limited"],
	["Hospital HIS", "Strong", "Strong", "Limited", "Varies", "Strong", "Limited"],
];

const principleCards = [
	{ title: "SHORT CONSULTATIONS", desc: "Capture first, AI-completed" },
	{ title: "AI CAN MISS INFORMATION", desc: "Design for review" },
	{ title: "AI SHOULDN'T INTERRUPT CARE", desc: "Assist in the background" },
	{ title: "CLINICAL DATA IS COMPLEX", desc: "Structure where possible" },
];

const deviceCaptions = [
	{ device: "Desktop", text: "for deep work" },
	{ device: "Tablet", text: "for consultation" },
	{ device: "Mobile", text: "for on the go use" },
];

const resultCards = [
	{ value: "45%", label: "reduction in documentation time" },
	{ value: "60–70%", label: "improvement in structured data completeness" },
	{ value: "30%", label: "reduction in missed clinical inputs" },
	{ value: "2×", label: "faster prescription generation" },
];

const citations = [
	"Sinsky et al.; Rule et al.",
	"Olson et al., JAMA Network Open, 2025",
	"Irving et al., BMJ Open, 2017",
];
---

<Layout title="ONI CARES — Maryamul Aasia">
	<Header active="works" />

	<main class="oni">
		<!-- ============ HERO ============ -->
		<section class="hero">
			<div class="hero__device reveal">
				<img src="/images/ONI/oni-hero.png" alt="ONI Cares doctor dashboard shown on tablet, laptop and phone" />
				<p class="hero__tags">UX/ Product design<br />Healthcare UX</p>
			</div>
			<div class="hero__copy reveal" style="--reveal-delay:120ms">
				<h1 class="hero__title">
					<PixelText text="ONI CARES" pixel={[5, 7]} />
				</h1>
				<p class="hero__subtitle">AI - Powered tool for Gynecologists</p>
			</div>
		</section>

		<!-- ============ META ROW ============ -->
		<section class="block meta reveal">
			<div class="meta__row">
				{
					metaRow.map((m, i) => (
						<>
							{i > 0 && <span class="meta__divider" aria-hidden="true" />}
							<div class="meta__col">
								<p class="meta__label">{m.label}</p>
								<p class="meta__value">{m.value}</p>
							</div>
						</>
					))
				}
			</div>
		</section>

		<!-- ============ ABOUT ONI ============ -->
		<section class="block reveal">
			<div class="zgrid zgrid--mid">
				<div class="zgrid__left">
					<h2 class="h2"><PixelText text="ABOUT" pixel={[2]} /><br /><PixelText text="ONI" pixel={[0]} /></h2>
				</div>
				<div class="zgrid__right">
					<p class="sidewhite">Designing an AI Assistant for High-Stakes Medical Consultations</p>
				</div>
			</div>
			<div class="zgrid zgrid--mid zgrid--tight">
				<div class="zgrid__left">
					<p class="bodycol">
						ONI (Continuum Pregnancy Care) is an AI-powered healthcare platform connecting Ob-Gyns,
						clinic staff, and expecting mothers through a unified pregnancy-care ecosystem, with a
						doctor-facing Electronic Medical Record (EMR), mother-facing mobile app, and shared design
						system.
					</p>
					<p class="bodycol">
						Doctors need to <strong>diagnose, decide, and document</strong>, without losing focus on the
						patient.
					</p>
				</div>
				<div class="zgrid__right">
					<div class="about__art">
						<img src="/images/ONI/About.png" alt="Glitch-art silhouette of a pregnant figure" />
					</div>
				</div>
			</div>
		</section>

		<!-- ============ PROBLEM STATEMENT ============ -->
		<section class="block reveal">
			<div class="zgrid">
				<div class="zgrid__left">
					<h2 class="h2"><PixelText text="PROBLEM" pixel={[2, 6]} /><br /><PixelText text="STATEMNT" pixel={[5]} /></h2>
				</div>
				<div class="zgrid__right">
					<blockquote class="sidewhite sidewhite--quote">
						&ldquo;The information isn&rsquo;t the problem. It&rsquo;s documenting everything accurately while
						managing the consultation.&rdquo;<br />
						<span>~ Gynaecologist research interview</span>
					</blockquote>
				</div>
			</div>

			<div class="zgrid zgrid--mid zgrid--tight">
				<div class="zgrid__left">
					<div class="problem__img">
						<img src="/images/ONI/Problem statement.png" alt="Doctor-facing EMR treatment screen with prescription and notes" />
					</div>
				</div>
				<div class="zgrid__right">
					<p class="bodycol">
						The existing EMR relied heavily on manual documentation, making it difficult for doctors to
						capture information while managing the patient conversation.
					</p>
					<p class="sidewhite">High patient volume &middot; Time-sensitive consultations &middot; Diagnosis + documentation</p>
				</div>
			</div>

			<div class="cardgrid">
				{
					problemCards.map((c) => (
						<NotchBox width={468} height={168} class="cardgrid__item">
							<div class="notchcard">
								<h3 class="notchcard__title pixelify">{c.title}</h3>
								<p class="notchcard__desc">{c.desc}</p>
							</div>
						</NotchBox>
					))
				}
			</div>
		</section>

		<!-- ============ MY ROLE ============ -->
		<section class="block reveal">
			<div class="headrow">
				<h2 class="h2"><PixelText text="MY" pixel={[0, 1]} /> <PixelText text="ROLE" pixel={[1]} /></h2>
				<p class="headrow__side">Cross function collaboration, System thinking and&nbsp; Problem solving</p>
			</div>
			<p class="bodycol">
				I worked as the <strong>Product Designer for ONI&rsquo;s doctor-facing experience</strong>, focusing
				on how AI could reduce documentation effort without interrupting care.
			</p>
			<div class="cardgrid">
				{
					roleCards.map((c) => (
						<NotchBox width={468} height={168} class="cardgrid__item">
							<div class="notchcard">
								<h3 class="notchcard__title pixelify">{c.title}</h3>
								<p class="notchcard__desc">{c.desc}</p>
							</div>
						</NotchBox>
					))
				}
			</div>
		</section>

		<!-- ============ USER RESEARCH ============ -->
		<section class="block reveal">
			<div class="ur__header">
				<span class="ur__star" aria-hidden="true">
					<svg viewBox="0 0 24 24"><path d="M12 1 C12.5 7 17 11.5 23 12 C17 12.5 12.5 17 12 23 C11.5 17 7 12.5 1 12 C7 11.5 11.5 7 12 1 Z" fill="currentColor"/></svg>
				</span>
				<h2 class="ur__title pixelify">USER RESEARCH</h2>
				<svg class="ur__wire" viewBox="0 0 640 44" preserveAspectRatio="none" aria-hidden="true">
					<path d="M1 40 H210 C270 40 262 8 322 8 H639" stroke="#8a8a8a" stroke-width="2" fill="none" stroke-linecap="round"/>
				</svg>
				<span class="ur__hexes" aria-hidden="true">
					<svg viewBox="0 0 26 30"><path d="M13 1 L24 8 V22 L13 29 L2 22 V8 Z" stroke="#8a8a8a" stroke-width="1.4" fill="none"/></svg>
					<svg viewBox="0 0 26 30"><path d="M13 1 L24 8 V22 L13 29 L2 22 V8 Z" stroke="#8a8a8a" stroke-width="1.4" fill="none"/></svg>
					<svg viewBox="0 0 26 30"><path d="M13 1 L24 8 V22 L13 29 L2 22 V8 Z" stroke="#8a8a8a" stroke-width="1.4" fill="none"/></svg>
				</span>
			</div>

			<div class="headrow headrow--tight">
				<p class="bodycol bodycol--noindent">We interviewed gynaecologists across clinics and hospitals, revealing three recurring themes:</p>
				<p class="headrow__side">Time pressure &middot; Multitasking &middot; Low tolerance for unreliable AI</p>
			</div>

			<div class="doctorbox">
				<div class="doctorbox__photoWrap">
					<img class="doctorbox__photo" src="/images/ONI/User research.png" alt="Portrait of Dr. Zoya Khan, gynaecologist" />
				</div>
				<div class="doctorbox__content">
					<p>
						<em>Hello, I&rsquo;m Dr. Zoya Khan. Most of my day moves quickly from one patient to the next, so I rely{" "}
						<strong>heavily on conversation and memory to keep consultations moving.</strong></em>
					</p>
					<p>
						<em
							>I need technology to stay in the background capturing what matters, keeping records complete, and
							helping me follow through without taking over my decisions.</em
						>
					</p>
					<p class="doctorbox__need"><em>PRIMARY NEED &rarr; <strong>Capture accurately without interrupting care</strong></em></p>
					<p class="doctorbox__logLabel">PRACTICE&nbsp; LOG</p>
					<p class="doctorbox__log">20&ndash;35 CONSULTATIONS&nbsp; |&nbsp; HIGH-RISK CARE&nbsp; |&nbsp; HINDI + ENGLISH</p>
				</div>
			</div>

			<div class="connectorrow">
				<div class="connectorrow__seg connectorrow__seg--cap">
					<svg class="connectorrow__shape" viewBox="0 0 100 54" preserveAspectRatio="none" aria-hidden="true">
						<path d="M0,1 H78 C90,1 94,14 99,27 C94,40 90,53 78,53 H0" stroke="#8a8a8a" stroke-width="1.2" fill="none" vector-effect="non-scaling-stroke" />
					</svg>
					<span class="connectorrow__label">STATUS :</span> <span class="connectorrow__value">TIME-PRESSED</span>
				</div>
				<div class="connectorrow__seg connectorrow__seg--mid">
					<span class="connectorrow__label">PRIORITY :</span> <span class="connectorrow__value">PATIENT CONVERSATION</span>
				</div>
				<div class="connectorrow__seg connectorrow__seg--cap connectorrow__seg--capRight">
					<svg class="connectorrow__shape" viewBox="0 0 100 54" preserveAspectRatio="none" aria-hidden="true">
						<path d="M100,1 H22 C10,1 6,14 1,27 C6,40 10,53 22,53 H100" stroke="#8a8a8a" stroke-width="1.2" fill="none" vector-effect="non-scaling-stroke" />
					</svg>
					<span class="connectorrow__label">CONTROL :</span> <span class="connectorrow__value">DOCTOR LED</span>
				</div>
			</div>

			<div class="cardgrid cardgrid--four">
				{
					researchThemes.map((c) => (
						<div class="hexcard cardgrid__item cardgrid__item--sm">
							<svg class="hexcard__frame" viewBox="0 0 227 165" preserveAspectRatio="none" aria-hidden="true">
								<path d="M0,0 H207 L227,20 V165 H20 L0,145 Z" fill="none" stroke="#7a7a7a" stroke-width="1.5" vector-effect="non-scaling-stroke" />
							</svg>
							<div class="notchcard notchcard--sm">
								<h3 class="notchcard__title">{c.title}</h3>
								<p class="notchcard__desc">{c.desc}</p>
							</div>
						</div>
					))
				}
			</div>
		</section>

		<!-- ============ MARKET RESEARCH ============ -->
		<section class="block reveal">
			<div class="zgrid">
				<div class="zgrid__left">
					<h2 class="h2"><PixelText text="MARKET" pixel={[1, 4]} /><br /><PixelText text="RESEARCH" pixel={[4, 7]} /></h2>
				</div>
				<div class="zgrid__right">
					<p class="sidewhite">
						The opportunity wasn&rsquo;t simplifying documentation. It was lowering cognitive load.
					</p>
				</div>
			</div>
			<div class="zgrid zgrid--mid zgrid--tight">
				<div class="zgrid__left">
					<p class="bodycol">
						Documentation is a significant source of clinician workload. Physicians can spend nearly 2
						hours on EMR work per hour of direct patient care (Sinsky et al.). A 2026 study found 45% of
						EMR time occurred outside scheduled hours, averaging 3 hours per 8 scheduled hours (Rule et
						al.).
					</p>
					<p class="bodycol">
						<strong
							>In a 263-clinician study, reported burnout fell from 51.9% &rarr; 38.8% after 30 days with an
							ambient AI scribe, alongside a 54 mins&nbsp; reduction in after-hours documentation (Olson et al.,
							JAMA Network Open, 2025).</strong
						>
					</p>
				</div>
				<div class="zgrid__right">
					<div class="market__img">
						<img src="/images/ONI/market research.png" alt="Doctor consulting a young patient" />
					</div>
				</div>
			</div>
		</section>

		<!-- ============ INDIAN CONTEXT ============ -->
		<section class="block reveal">
			<h2 class="h3 center h3--secondary pixelify">INDIAN CONTEXT</h2>
			<div class="centercol">
				<p class="bodycol bodycol--center indian__body">
					A review of 28.5M primary-care consultations across 67 countries found consultation
					times ranging from 48 seconds to 22.5 minutes; in 18 countries, average
					consultations were 5 minutes or less (Irving et al., BMJ Open, 2017).
				</p>
				<p class="bodycol bodycol--center indian__body">This suggested a different approach from traditional ambient scribes:</p>
				<p class="bodycol bodycol--center indian__flow">Listen &rarr; Transcribe to Capture &rarr; AI Complete &rarr; Doctor Review</p>
			</div>
		</section>

		<!-- ============ COMPETITIVE LANDSCAPE ============ -->
		<section class="block reveal">
			<div class="headrow">
				<h2 class="h2"><PixelText text="COMPETITIVE" pixel={[2, 5]} /><br /><PixelText text="LANDSCAPE" pixel={[1, 2, 6]} /></h2>
				<p class="headrow__side">
					I evaluated competitors across: Clinical workflow &middot; Documentation &middot; AI assistance
					&middot; Specialty depth &middot; Patient context &middot; Device flexibility
				</p>
			</div>

			<div class="table-wrap">
				<table class="ctable">
					<thead>
						<tr>
							{competitiveHeaders.map((h) => <th><span class="tagchip pixelify">{h}</span></th>)}
						</tr>
					</thead>
					<tbody>
						{
							competitiveRows.map((row) => (
								<tr>
									<td class="ctable__name">{row[0]}</td>
									{row.slice(1).map((v) => <td>{v}</td>)}
								</tr>
							))
						}
					</tbody>
				</table>
			</div>

			<h3 class="h3 center h3--secondary pixelify">THE OPPORTUNITY</h3>
			<div class="centercol">
				<p class="bodycol bodycol--center">
					Most solutions focused on one part of the workflow: <strong>records, voice, practice
					management, or AI-assisted entry.</strong>
				</p>
				<p class="bodycol bodycol--center"><strong>ONI could connect patient context, clinical workflow, AI assistance, and pregnancy-specific care.</strong></p>
			</div>
		</section>

		<!-- ============ RESEARCH TO DESIGN PRINCIPLES ============ -->
		<section class="block reveal">
			<div class="headrow headrow--mid">
				<h2 class="h2"><PixelText text="RESEARCH" pixel={[2, 5]} /><br />TO <PixelText text="DESIGN" pixel={[5]} /><br />PRINCIPLES</h2>
				<p class="headrow__side">Doctors work across environments, so&nbsp; Design for each device</p>
			</div>

			<div class="cardgrid">
				{
					principleCards.map((c) => (
						<NotchBox width={468} height={168} class="cardgrid__item">
							<div class="notchcard">
								<h3 class="notchcard__title pixelify">{c.title}</h3>
								<p class="notchcard__desc">{c.desc}</p>
							</div>
						</NotchBox>
					))
				}
			</div>

			<div class="devicerow">
				{
					deviceCaptions.map((d) => (
						<p class="devicerow__item">
							<span class="devicerow__device">{d.device}</span> {d.text}
						</p>
					))
				}
			</div>
		</section>

		<!-- ============ USER JOURNEY ============ -->
		<section class="block reveal">
			<div class="headrow headrow--mid">
				<h2 class="h2"><PixelText text="USER" pixel={[2]} /><br /><PixelText text="JOURNEY" pixel={[4]} /></h2>
				<p class="headrow__side">
					The key opportunity was to move documentation into the consultation flow, rather than treating it
					as a separate task.
				</p>
			</div>

			<p class="journey__flow">Prepare &rarr; Review &rarr; Consult &rarr; Capture &rarr; Review &rarr; Prescribe &rarr; Follow-up</p>

			<div class="wide-img">
				<img src="/images/ONI/journey-map.png" alt="Five-stage doctor journey map with doing, thinking, feeling, friction and consequence rows" />
			</div>
		</section>

		<!-- ============ INFORMATION ARCHITECTURE ============ -->
		<section class="block reveal">
			<h2 class="h2"><PixelText text="INFORMATION" pixel={[6]} /><br /><PixelText text="ARCHITECTURE" pixel={[3, 7]} /></h2>
			<div class="wide-img wide-img--center">
				<img src="/images/ONI/information-architecture.png" alt="Information architecture tree for ONI doctors interface" />
			</div>
		</section>

		<!-- ============ USER FLOW ============ -->
		<section class="block reveal">
			<h2 class="h2"><PixelText text="USER" pixel={[2]} /> FLOW</h2>
			<div class="wide-img wide-img--flow">
				<img src="/images/ONI/user-flow.png" alt="User flow diagram from ONI home through consultation screens" />
			</div>
			<div class="wide-img wide-img--wireframes">
				<img src="/images/ONI/Wireframes.png" alt="Five black-and-white wireframe screens of the ONI doctor app" />
			</div>
		</section>

		<!-- ============ UI DESIGN / HOME SCREEN ============ -->
		<section class="block reveal">
			<div class="headrow">
				<h2 class="h2">UI <PixelText text="DESIGN" pixel={[5]} /></h2>
				<p class="headrow__side headrow__side--pixel pixelify">HOME SCREEN</p>
			</div>
			<p class="bodycol bodycol--wide">
				The general home screen across devices displays the doctor&rsquo;s profile, a basic patient summary,
				and the active queue. However, to fit the smaller mobile layout properly, the patient queue is
				removed from the mobile home screen and relocated to a separate screen.
			</p>
			<div class="devicetrio">
				<div class="devicetrio__desktop">
					<img src="/images/ONI/Home - desktop.png" alt="ONI home screen on desktop" />
				</div>
				<div class="devicetrio__tablet">
					<img src="/images/ONI/Home - Tablet.png" alt="ONI home screen on tablet" />
				</div>
				<div class="devicetrio__mobile">
					<img src="/images/ONI/Home - Mobile.png" alt="ONI home screen on mobile" />
				</div>
			</div>
		</section>

		<!-- ============ PRESCRIPTION FLOW ============ -->
		<section class="block reveal">
			<h2 class="h2 h2--secondary pixelify">PRESCRIPTION FLOW</h2>
			<div class="bodycol bodycol--wide bodycol--headspace">
				<p>
					One of the biggest design challenges was breaking down a complex desktop prescription page which
					displays everything simultaneously into smaller sections. For tablets, adding sub-tabs made it
					easy for doctors to track their location and remember to scroll. However, on mobile. I was bit
					Challenging
				</p>
				<p class="bodycol__p2">
					On the desktop prescription page, all sections were displayed simultaneously, including symptoms
					medication, supplements medication , doctor notes, follow-up dates, and additional tests.
				</p>
			</div>

			<div class="rx__pair">
				<div class="rx__desktop">
					<img src="/images/ONI/Medication - desktop.png" alt="Prescription screen on desktop" />
				</div>
				<div class="rx__tablet-wrap">
					<div class="rx__tablet">
						<img src="/images/ONI/medicatio - tablet.png" alt="Prescription screen on tablet with sub-tabs" />
					</div>
				</div>
			</div>

			<p class="bodycol bodycol--wide">
				On mobile screens, each of those subsections is separated into its own individual screen instead of
				appearing all at once.
			</p>
			<div class="wide-img wide-img--rxmobile">
				<img src="/images/ONI/Medication - mobile.png" alt="Six mobile prescription flow screens in sequence" />
			</div>
		</section>

		<!-- ============ KEEPING PATIENT RISK ALWAYS VISIBLE ============ -->
		<section class="block reveal">
			<h2 class="h2 h2--secondary pixelify">KEEPING PATIENT RISK ALWAYS VISIBLE</h2>
			<p class="bodycol bodycol--wide bodycol--headspace">
				I surfaced the risk level at the top of the patient card, keeping it visible even while scrolling on
				mobile. The same risk indicator is reinforced within the appointment view, so critical patient
				context stays easy to spot throughout the consultation.
			</p>

			<div class="riskrow">
				<div class="riskrow__phones">
					<img src="/images/ONI/risk mobile.png" alt="Two ONI mobile screens showing risk badges in the header and appointment list" />
				</div>
			</div>
		</section>

		<!-- ============ VALIDATION & RESULTS ============ -->
		<section class="block reveal">
			<div class="headrow">
				<h2 class="h2"><PixelText text="VALIDATION" pixel={[1, 5]} /> <span class="px">&amp;</span> <PixelText text="RESULTS" pixel={[6]} /></h2>
